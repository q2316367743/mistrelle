<!DOCTYPE html>
<!-- 模型可用性审计报告（可用性检测工具）。
  数据契约（渲染侧 health-report.ts 预处理 view model，模板只做展示循环）：
  { title, checkedAt, generatedAt, conclusion: { label, tone },
    stats: [{ label, value, tone }], info: [{ label, value }], advice,
    itemCount, groups: [{ dimension, items: [{ statusLabel, statusTone, name, latency, detail }] }],
    logs: [{ time, level, message }] }
  插值一律用 <%= %>（EJS 默认 HTML 转义）：detail 含模型自述等不可信文本，禁止 <%- %>。 -->
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: #f3f4f8;
    color: #1f2329;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .report { max-width: 920px; margin: 0 auto; padding: 32px 20px 24px; }

  /* ── 报告头（按结论着色的渐变横幅） ── */
  .report-header {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 28px 32px; border-radius: 14px; color: #fff;
    box-shadow: 0 4px 16px rgba(31, 35, 41, 0.16);
  }
  .report-header h1 { font-size: 22px; font-weight: 600; letter-spacing: 0.5px; }
  .report-header .meta { margin-top: 6px; font-size: 12.5px; opacity: 0.85; }
  .conclusion-badge {
    flex-shrink: 0; padding: 10px 22px; border-radius: 999px;
    font-size: 18px; font-weight: 700; background: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.45); backdrop-filter: blur(4px);
  }

  /* ── 结论色调（横幅渐变 / 徽章 / 统计卡共用） ── */
  .tone-healthy { --tone: #107c41; --tone-deep: #0b5a30; }
  .tone-risky { --tone: #ca5010; --tone-deep: #93400c; }
  .tone-danger { --tone: #c42b1c; --tone-deep: #8f1f14; }
  .tone-unknown { --tone: #5b6470; --tone-deep: #404852; }
  .tone-healthy.report-header, .tone-risky.report-header, .tone-danger.report-header, .tone-unknown.report-header {
    background: linear-gradient(135deg, var(--tone) 0%, var(--tone-deep) 100%);
  }

  /* ── 统计卡 ── */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 18px; }
  .stat-card {
    padding: 16px 18px; border-radius: 10px; background: #fff;
    border-top: 3px solid var(--tone);
    box-shadow: 0 2px 8px rgba(31, 35, 41, 0.08);
  }
  .stat-value { font-size: 26px; font-weight: 700; color: var(--tone); font-variant-numeric: tabular-nums; }
  .stat-label { margin-top: 2px; font-size: 12.5px; color: #6b7280; }

  /* ── 内容卡 ── */
  .card {
    margin-top: 18px; padding: 22px 26px; border-radius: 10px; background: #fff;
    box-shadow: 0 2px 8px rgba(31, 35, 41, 0.08);
  }
  .card h2 { font-size: 15px; font-weight: 600; color: #1f2329; margin-bottom: 14px; }
  .card h2 .count { font-weight: 400; color: #6b7280; font-size: 12.5px; margin-left: 6px; }

  /* ── 基本信息网格 ── */
  .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 32px; }
  .info-item { display: flex; gap: 10px; font-size: 13px; min-width: 0; }
  .info-label { flex-shrink: 0; width: 64px; color: #6b7280; }
  .info-value { color: #1f2329; word-break: break-all; }

  /* ── 结论建议 ── */
  .advice { border-left: 4px solid var(--tone); }
  .advice p { font-size: 13.5px; color: #3b4048; }

  /* ── 维度明细表 ── */
  .dimension + .dimension { margin-top: 18px; }
  .dimension h3 {
    font-size: 13px; font-weight: 600; color: #4b5563;
    padding-bottom: 8px; margin-bottom: 8px; border-bottom: 1px solid #eef0f3;
  }
  table { width: 100%; border-collapse: collapse; }
  th { font-size: 12px; font-weight: 600; color: #6b7280; text-align: left; padding: 6px 8px; }
  td { font-size: 13px; padding: 8px; border-top: 1px solid #f0f1f4; vertical-align: top; }
  tbody tr:hover { background: #f8f9fb; }
  .col-status { width: 64px; }
  .col-latency { width: 72px; }
  .badge {
    display: inline-block; padding: 2px 10px; border-radius: 999px;
    font-size: 12px; font-weight: 600; color: var(--tone); background: color-mix(in srgb, var(--tone) 12%, #fff);
  }
  td.item-name { font-weight: 500; white-space: nowrap; }
  td.latency { color: #6b7280; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.detail { color: #4b5563; word-break: break-all; }

  /* ── 执行日志 ── */
  .logs { max-height: 420px; overflow-y: auto; padding: 10px 12px; border-radius: 8px; background: #f8f9fb; }
  .log-line { display: flex; gap: 10px; font-size: 12px; line-height: 1.9;
    font-family: "SF Mono", "Cascadia Code", Consolas, monospace; }
  .log-time { flex-shrink: 0; color: #9ca3af; }
  .log-level { flex-shrink: 0; width: 42px; font-weight: 700; }
  .level-info { color: #0078d4; }
  .level-warn { color: #ca5010; }
  .level-error { color: #c42b1c; }
  .log-message { color: #4b5563; word-break: break-all; }

  /* ── 页脚 ── */
  .report-footer { margin-top: 22px; text-align: center; font-size: 12px; color: #9ca3af; }

  @media (max-width: 640px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .info-grid { grid-template-columns: 1fr; }
    .report-header { flex-direction: column; align-items: flex-start; }
  }
  @media print {
    body { background: #fff; }
    .report { max-width: none; padding: 0; }
    .card, .stat-card, .report-header { box-shadow: none; border: 1px solid #e5e7eb; }
    .logs { max-height: none; overflow: visible; }
  }
</style>
</head>
<body>
<div class="report">
  <header class="report-header tone-<%= conclusion.tone %>">
    <div>
      <h1><%= title %></h1>
      <p class="meta">检测时间 <%= checkedAt %> · 报告生成 <%= generatedAt %></p>
    </div>
    <div class="conclusion-badge"><%= conclusion.label %></div>
  </header>

  <section class="stats">
    <% stats.forEach(function (s) { %>
    <div class="stat-card tone-<%= s.tone %>">
      <div class="stat-value"><%= s.value %></div>
      <div class="stat-label"><%= s.label %></div>
    </div>
    <% }) %>
  </section>

  <section class="card">
    <h2>基本信息</h2>
    <div class="info-grid">
      <% info.forEach(function (i) { %>
      <div class="info-item">
        <span class="info-label"><%= i.label %></span>
        <span class="info-value"><%= i.value %></span>
      </div>
      <% }) %>
    </div>
  </section>

  <section class="card advice tone-<%= conclusion.tone %>">
    <h2>结论与建议</h2>
    <p><%= advice %></p>
  </section>

  <section class="card">
    <h2>检测项明细<span class="count">共 <%= itemCount %> 项</span></h2>
    <% groups.forEach(function (g) { %>
    <div class="dimension">
      <h3><%= g.dimension %></h3>
      <table>
        <thead>
          <tr><th class="col-status">结果</th><th>检测项</th><th class="col-latency">耗时</th><th>说明</th></tr>
        </thead>
        <tbody>
          <% g.items.forEach(function (it) { %>
          <tr>
            <td><span class="badge tone-<%= it.statusTone %>"><%= it.statusLabel %></span></td>
            <td class="item-name"><%= it.name %></td>
            <td class="latency"><%= it.latency %></td>
            <td class="detail"><%= it.detail %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% }) %>
  </section>

  <section class="card">
    <h2>执行日志<span class="count">共 <%= logs.length %> 条</span></h2>
    <div class="logs">
      <% logs.forEach(function (l) { %>
      <div class="log-line">
        <span class="log-time"><%= l.time %></span>
        <span class="log-level level-<%= l.level %>"><%= l.level.toUpperCase() %></span>
        <span class="log-message"><%= l.message %></span>
      </div>
      <% }) %>
    </div>
  </section>

  <footer class="report-footer">
    <p>本报告由 Mistrelle 可用性检测工具本地生成 · 检测结果仅供参考，不构成任何担保</p>
  </footer>
</div>
</body>
</html>
